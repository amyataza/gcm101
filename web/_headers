# Response headers for Netlify and Cloudflare Pages (ignored by other hosts; the CSP is also set in index.html).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qXleFrSJLKYuN1rf+eLNP4MbuM+2+gmn5+C6oHKSaBo=' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache
/sw-manifest.js
  Cache-Control: no-cache
/content/audio/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
