{
  "_about": "Kinesthetic ('Do') activities. Explorers start at the inputs of the syllabus example they name; outputs are computed by calc.js. Sequencers and classifiers quote syllabus steps or key-term definitions; `basis` says where. place = 'learn' shows the activity on the Learn page; otherwise it appears under its example in Practise. Every module also gets an automatic key-term matching game and, where it has Track A steps, Track B formulas or Track C code, a walkthrough, spreadsheet pack and Python runner.",
  "items": [
    { "id": "m0-bp", "type": "explorer", "module": "m0", "example": "we-0.1", "exampleLabel": "Worked example 0.1", "title": "Points, basis points and percent",
      "inputs": [{ "id": "from", "label": "Old rate", "min": 0, "max": 20, "step": 0.25, "value": 7.5, "unit": "%" }, { "id": "to", "label": "New rate", "min": 0, "max": 20, "step": 0.25, "value": 8.25, "unit": "%" }],
      "outputs": [{ "label": "Change in percentage points", "calc": "sub", "args": ["to", "from"], "dp": 2 }, { "label": "Change in basis points", "calc": "bpChange", "args": ["from", "to"], "dp": 0, "unit": "bp" }, { "label": "Relative (percentage) change", "calc": "pctChange", "args": ["from", "to"], "scale": 100, "dp": 2, "unit": "%" }] },
    { "id": "m0-updown", "type": "explorer", "module": "m0", "example": "we-0.2", "exampleLabel": "Worked example 0.2", "title": "Up then down by the same percentage",
      "inputs": [{ "id": "p", "label": "Starting price", "min": 10, "max": 1000, "step": 10, "value": 100 }, { "id": "u", "label": "Rise, then fall, of", "min": 0, "max": 60, "step": 1, "value": 10, "unit": "%" }],
      "outputs": [{ "label": "Value after the rise and fall", "calc": "compound", "args": ["p", "u%", "-u%"], "dp": 2 }, { "label": "Overall change", "calc": "upDownChange", "args": ["u%"], "scale": 100, "dp": 2, "unit": "%" }],
      "chart": { "x": "u", "output": 1, "xLabel": "Size of the rise and the fall (%)", "yLabel": "Overall change (%)" },
      "note": "The bigger the swings, the more is lost: the fall is applied to a bigger base." },

    { "id": "m1-outside", "type": "explorer", "module": "m1", "example": "case-1.1", "exampleLabel": "Case 1.1 (SIFMA 2026 Fact Book [R1])", "title": "Market size outside the US",
      "inputs": [{ "id": "eq", "label": "Global equity market capitalisation (US$ tn)", "min": 50, "max": 250, "step": 0.1, "value": 157.8 }, { "id": "eus", "label": "US share of equity", "min": 0, "max": 100, "step": 0.1, "value": 43.7, "unit": "%" }, { "id": "bd", "label": "Global bonds outstanding (US$ tn)", "min": 50, "max": 250, "step": 0.1, "value": 160.7 }, { "id": "bus", "label": "US share of bonds", "min": 0, "max": 100, "step": 0.1, "value": 38.1, "unit": "%" }],
      "outputs": [{ "label": "Non-US equity (US$ tn)", "calc": "shareOutside", "args": ["eq", "eus%"], "dp": 1 }, { "label": "Non-US bonds (US$ tn)", "calc": "shareOutside", "args": ["bd", "bus%"], "dp": 1 }],
      "note": "The starting values are the end-2025 figures cited in the syllabus [R1]. Values you set yourself are hypothetical." },
    { "id": "m1-segments", "type": "classifier", "module": "m1", "place": "learn", "title": "Which part of the market is it?", "buckets": ["Primary market", "Secondary market", "Exchange", "Over-the-counter (OTC)"],
      "items": [{ "text": "Newly created securities are sold by issuers to investors.", "bucket": "Primary market" }, { "text": "Existing securities are traded between investors.", "bucket": "Secondary market" }, { "text": "A regulated marketplace with standard rules where buyers and sellers meet.", "bucket": "Exchange" }, { "text": "Trading negotiated directly between two parties.", "bucket": "Over-the-counter (OTC)" }],
      "basis": "the M1 key-term table" },

