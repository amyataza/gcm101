      "chart": { "x": "n", "output": 0, "xLabel": "Years", "yLabel": "Value (R)" } },
    { "id": "m4-pv", "type": "explorer", "module": "m4", "example": "we-4.2", "exampleLabel": "Worked example 4.2", "title": "What is future money worth today?",
      "inputs": [{ "id": "fv", "label": "Amount received later (US$)", "min": 100, "max": 10000, "step": 100, "value": 1000 }, { "id": "r", "label": "Discount rate", "min": 0, "max": 25, "step": 0.5, "value": 6, "unit": "%" }, { "id": "n", "label": "Years until received", "min": 0, "max": 40, "step": 1, "value": 3 }],
      "outputs": [{ "label": "Present value", "calc": "pv", "args": ["fv", "r%", "n"], "dp": 2, "unit": "US$", "prefix": true }, { "label": "Discount factor", "calc": "discountFactor", "args": ["r%", "n"], "dp": 6 }],
      "chart": { "x": "r", "output": 0, "xLabel": "Discount rate (%)", "yLabel": "Present value (US$)" } },
