      "outputs": [{ "label": "Annual premium", "calc": "cds", "args": ["n", "bp", "rec%"], "pick": "premium", "dp": 0 }, { "label": "Payout on default", "calc": "cds", "args": ["n", "bp", "rec%"], "pick": "payout", "dp": 0 }] },

    { "id": "m10-nav", "type": "explorer", "module": "m10", "example": "we-10.2", "exampleLabel": "Worked examples 10.1–10.2", "title": "NAV and a closed-ended fund’s discount",
      "inputs": [{ "id": "a", "label": "Assets (millions)", "min": 10, "max": 500, "step": 1, "value": 105 }, { "id": "l", "label": "Liabilities (millions)", "min": 0, "max": 100, "step": 1, "value": 5 }, { "id": "u", "label": "Units/shares (millions)", "min": 1, "max": 100, "step": 1, "value": 10 }, { "id": "p", "label": "Share price on the exchange", "min": 1, "max": 50, "step": 0.1, "value": 9.2 }],
      "outputs": [{ "label": "NAV per unit", "calc": "navCheck", "args": ["a", "l", "u", "p"], "pick": "nav", "dp": 2 }, { "label": "Premium (+) / discount (−)", "calc": "navCheck", "args": ["a", "l", "u", "p"], "pick": "pd", "scale": 100, "dp": 2, "unit": "%" }] },
    { "id": "m10-fees", "type": "explorer", "module": "m10", "example": "we-10.3", "exampleLabel": "Worked example 10.3", "title": "What fees do over time",
      "inputs": [{ "id": "s", "label": "Amount invested", "min": 1000, "max": 100000, "step": 1000, "value": 10000 }, { "id": "g", "label": "Return before costs", "min": 0, "max": 15, "step": 0.5, "value": 7, "unit": "%" }, { "id": "fa", "label": "Fund A annual cost", "min": 0, "max": 3, "step": 0.05, "value": 0.2, "unit": "%" }, { "id": "fb", "label": "Fund B annual cost", "min": 0, "max": 3, "step": 0.05, "value": 1.5, "unit": "%" }, { "id": "y", "label": "Years", "min": 1, "max": 40, "step": 1, "value": 20 }],
      "outputs": [{ "label": "Fund A ends with", "calc": "fundPair", "args": ["s", "g%", "fa%", "fb%", "y"], "pick": "a", "dp": 2 }, { "label": "Fund B ends with", "calc": "fundPair", "args": ["s", "g%", "fa%", "fb%", "y"], "pick": "b", "dp": 2 }, { "label": "Difference", "calc": "fundPair", "args": ["s", "g%", "fa%", "fb%", "y"], "pick": "gap", "dp": 2 }],
      "chart": { "x": "y", "output": 2, "xLabel": "Years", "yLabel": "Difference A − B" } },
    { "id": "m10-vehicles", "type": "classifier", "module": "m10", "place": "learn", "title": "Which kind of fund?", "buckets": ["Open-ended fund", "Closed-ended fund", "Exchange-traded fund (ETF)", "REIT"],
      "items": [{ "text": "Issues and cancels units on demand at NAV.", "bucket": "Open-ended fund" }, { "text": "A fixed number of shares trade on an exchange, often at a premium or discount to NAV.", "bucket": "Closed-ended fund" }, { "text": "Its shares trade on an exchange throughout the day, usually tracking an index.", "bucket": "Exchange-traded fund (ETF)" }, { "text": "A listed company that owns income-producing property and distributes most of its income.", "bucket": "REIT" }],
      "basis": "the M10 key-term table" },

    { "id": "m11-ipo", "type": "explorer", "module": "m11", "example": "we-11.1", "exampleLabel": "Worked example 11.1", "title": "IPO arithmetic",
      "inputs": [{ "id": "n", "label": "New shares sold (millions)", "min": 1, "max": 500, "step": 1, "value": 50 }, { "id": "p", "label": "Issue price (R)", "min": 1, "max": 100, "step": 0.5, "value": 20 }, { "id": "f", "label": "Underwriting fee", "min": 0, "max": 8, "step": 0.25, "value": 3, "unit": "%" }, { "id": "c", "label": "First-day closing price (R)", "min": 1, "max": 150, "step": 0.5, "value": 23 }],
      "outputs": [{ "label": "Gross proceeds (R million)", "calc": "ipoFigures", "args": ["n", "p", "f%", "c"], "pick": "gross", "dp": 2 }, { "label": "Net proceeds (R million)", "calc": "ipoFigures", "args": ["n", "p", "f%", "c"], "pick": "net", "dp": 2 }, { "label": "First-day return", "calc": "ipoFigures", "args": ["n", "p", "f%", "c"], "pick": "firstDay", "scale": 100, "dp": 2, "unit": "%" }, { "label": "Money left on the table (R million)", "calc": "ipoFigures", "args": ["n", "p", "f%", "c"], "pick": "leftOnTable", "dp": 2 }] },
    { "id": "m11-auction", "type": "auction", "module": "m11", "example": "we-11.2", "title": "Run a Treasury-bill auction" },
    { "id": "m11-road", "type": "sequencer", "module": "m11", "example": "case-11.1", "title": "The road to an IPO",
      "steps": ["Preparatory and organisational meetings", "Due diligence", "Drafting the prospectus", "Regulatory review", "Investor roadshow", "Bookbuilding", "Pricing", "Allocation", "Stabilisation"], "basis": "the stages listed in Case 11.1 (from NYIF [S10])" },

    { "id": "m12-book", "type": "orderbook", "module": "m12", "example": "we-12.1", "title": "Walk the order book" },
    { "id": "m12-short", "type": "explorer", "module": "m12", "example": "we-12.2", "exampleLabel": "Worked example 12.2", "title": "Short selling: gains, fees and open-ended losses",
      "inputs": [{ "id": "q", "label": "Shares sold short", "min": 100, "max": 10000, "step": 100, "value": 1000 }, { "id": "s", "label": "Sale price", "min": 1, "max": 200, "step": 1, "value": 60 }, { "id": "b", "label": "Buy-back price", "min": 1, "max": 200, "step": 1, "value": 52 }, { "id": "f", "label": "Lending fee a year", "min": 0, "max": 10, "step": 0.25, "value": 0.5, "unit": "%" }, { "id": "m", "label": "Months held", "min": 1, "max": 24, "step": 1, "value": 3 }],
      "outputs": [{ "label": "Profit (+) or loss (−)", "calc": "shortSale", "args": ["q", "s", "b", "f%", "m"], "pick": "profit", "dp": 2 }, { "label": "Lending fee", "calc": "shortSale", "args": ["q", "s", "b", "f%", "m"], "pick": "fee", "dp": 2 }],
      "chart": { "x": "b", "output": 0, "xLabel": "Buy-back price", "yLabel": "Profit or loss", "yZero": true },
      "note": "The loss line keeps falling as the buy-back price rises: there is no ceiling on the price." },
    { "id": "m12-margin", "type": "explorer", "module": "m12", "example": "we-12.3", "exampleLabel": "Worked example 12.3", "title": "Buying on margin",
      "inputs": [{ "id": "n", "label": "Shares bought", "min": 100, "max": 10000, "step": 100, "value": 1000 }, { "id": "p", "label": "Current share price", "min": 1, "max": 100, "step": 0.5, "value": 40 }, { "id": "loan", "label": "Amount borrowed", "min": 0, "max": 100000, "step": 1000, "value": 25000 }, { "id": "mm", "label": "Required equity", "min": 5, "max": 60, "step": 5, "value": 30, "unit": "%" }],
      "outputs": [{ "label": "Your equity", "calc": "marginPosition", "args": ["n", "p", "loan", "mm%"], "pick": "equity", "dp": 2 }, { "label": "Equity as % of position", "calc": "marginPosition", "args": ["n", "p", "loan", "mm%"], "pick": "ratio", "scale": 100, "dp": 1, "unit": "%" }, { "label": "Margin call below this price", "calc": "marginPosition", "args": ["n", "p", "loan", "mm%"], "pick": "callPrice", "dp": 2 }],
      "chart": { "x": "p", "output": 1, "xLabel": "Share price", "yLabel": "Equity ratio (%)" } },
    { "id": "m12-netting", "type": "netting", "module": "m12", "example": "we-12.4", "title": "See netting at work" },
    { "id": "m12-dates", "type": "settlement", "module": "m12", "example": "we-12.5", "title": "Work out settlement dates" },
    { "id": "m12-posttrade", "type": "sequencer", "module": "m12", "place": "learn", "title": "Follow one trade after execution",
      "steps": ["The trade is agreed on a trading venue (trade date, T)", "Trade capture, confirmation and affirmation", "Clearing: the CCP steps in (novation), nets obligations and collects margin", "Settlement at the CSD: delivery versus payment", "Custody and asset servicing (income, corporate actions)"], "basis": "M12 objective 6 and the post-trade subtopics" },

    { "id": "m13-price", "type": "explorer", "module": "m13", "example": "we-13.1", "exampleLabel": "Worked examples 13.1 and 13.6", "title": "Price, yield and duration",
      "inputs": [{ "id": "c", "label": "Annual coupon", "min": 0, "max": 15, "step": 0.25, "value": 8, "unit": "%" }, { "id": "y", "label": "Market yield", "min": 0.25, "max": 20, "step": 0.25, "value": 10, "unit": "%" }, { "id": "n", "label": "Years to maturity", "min": 1, "max": 30, "step": 1, "value": 5 }],
      "outputs": [{ "label": "Price (face 1,000)", "calc": "bondPrice", "args": [1000, "c%", "y%", "n", 1], "dp": 2 }, { "label": "Macaulay duration (years)", "calc": "bondRisk", "args": [1000, "c%", "y%", "n"], "pick": "macaulay", "dp": 2 }, { "label": "Modified duration", "calc": "bondRisk", "args": [1000, "c%", "y%", "n"], "pick": "modified", "dp": 2 }, { "label": "DV01", "calc": "bondRisk", "args": [1000, "c%", "y%", "n"], "pick": "dv01", "dp": 4 }],
      "chart": { "x": "y", "output": 0, "xLabel": "Market yield (%)", "yLabel": "Price" },
      "note": "The curve bends (convexity): prices fall less when yields rise than they gain when yields fall. Longer maturities make the curve steeper." },
    { "id": "m13-forward", "type": "explorer", "module": "m13", "example": "we-13.7", "exampleLabel": "Worked example 13.7", "title": "Forward rate from two spot rates",
      "inputs": [{ "id": "s1", "label": "1-year spot rate", "min": 0, "max": 15, "step": 0.25, "value": 6, "unit": "%" }, { "id": "s2", "label": "2-year spot rate", "min": 0, "max": 15, "step": 0.25, "value": 6.5, "unit": "%" }],
      "outputs": [{ "label": "Implied 1-year rate starting in 1 year", "calc": "forwardRate", "args": ["s1%", "s2%"], "scale": 100, "dp": 2, "unit": "%" }] },
    { "id": "m13-svb", "type": "explorer", "module": "m13", "example": "case-13.1", "exampleLabel": "Case 13.1", "title": "Duration and a rate shock",
      "inputs": [{ "id": "md", "label": "Modified duration of the portfolio", "min": 0.5, "max": 15, "step": 0.5, "value": 6 }, { "id": "dy", "label": "Rise in yields", "min": 0, "max": 6, "step": 0.25, "value": 3, "unit": "%" }],
      "outputs": [{ "label": "Approximate change in value", "calc": "durationLossPct", "args": ["md", "dy%"], "scale": 100, "dp": 1, "unit": "%" }],
      "chart": { "x": "dy", "output": 0, "xLabel": "Rise in yields (percentage points)", "yLabel": "Change in value (%)" } },

    { "id": "m14-capm", "type": "explorer", "module": "m14", "example": "we-14.2", "exampleLabel": "Worked example 14.2", "title": "Cost of equity with CAPM",
      "inputs": [{ "id": "rf", "label": "Government bond yield (risk-free)", "min": 0, "max": 15, "step": 0.25, "value": 8, "unit": "%" }, { "id": "b", "label": "Beta", "min": 0, "max": 2.5, "step": 0.05, "value": 1.2 }, { "id": "erp", "label": "Equity risk premium", "min": 0, "max": 12, "step": 0.25, "value": 6, "unit": "%" }],
      "outputs": [{ "label": "Cost of equity", "calc": "capm", "args": ["rf%", "b", "erp%"], "scale": 100, "dp": 2, "unit": "%" }],
      "chart": { "x": "b", "output": 0, "xLabel": "Beta", "yLabel": "Cost of equity (%)" } },
    { "id": "m14-gordon", "type": "explorer", "module": "m14", "example": "we-14.4", "exampleLabel": "Worked examples 14.3–14.4", "title": "How sensitive is the growth model?",
      "inputs": [{ "id": "d0", "label": "Dividend just paid", "min": 0.1, "max": 10, "step": 0.05, "value": 2 }, { "id": "g", "label": "Growth forever", "min": 0, "max": 9, "step": 0.25, "value": 5, "unit": "%" }, { "id": "k", "label": "Required return", "min": 6, "max": 20, "step": 0.25, "value": 11, "unit": "%" }],
      "outputs": [{ "label": "Value per share", "calc": "gordon", "args": ["d0", "g%", "k%"], "dp": 2 }],
      "chart": { "x": "g", "output": 0, "xLabel": "Growth rate (%)", "yLabel": "Value per share" },
      "note": "As growth approaches the required return, the value shoots up — a sign that precise-looking valuations rest on uncertain assumptions. The model needs k > g." },
    { "id": "m14-dcf", "type": "explorer", "module": "m14", "example": "we-14.6", "exampleLabel": "Worked example 14.6", "title": "A five-year DCF",
      "inputs": [{ "id": "a", "label": "FCFE year 1", "min": 0, "max": 150, "step": 1, "value": 50 }, { "id": "b", "label": "FCFE year 2", "min": 0, "max": 150, "step": 1, "value": 55 }, { "id": "c", "label": "FCFE year 3", "min": 0, "max": 150, "step": 1, "value": 60 }, { "id": "d", "label": "FCFE year 4", "min": 0, "max": 150, "step": 1, "value": 64 }, { "id": "e", "label": "FCFE year 5", "min": 0, "max": 150, "step": 1, "value": 67 }, { "id": "k", "label": "Cost of equity", "min": 6, "max": 25, "step": 0.25, "value": 13, "unit": "%" }, { "id": "g", "label": "Growth after year 5", "min": 0, "max": 5.75, "step": 0.25, "value": 5, "unit": "%" }, { "id": "sh", "label": "Shares (millions)", "min": 10, "max": 500, "step": 10, "value": 100 }],
      "outputs": [{ "label": "Value per share", "calc": "dcfPerShare", "args": ["a", "b", "c", "d", "e", "k%", "g%", "sh"], "dp": 2 }],
      "chart": { "x": "k", "output": 0, "xLabel": "Cost of equity (%)", "yLabel": "Value per share" } },
    { "id": "m14-income", "type": "sequencer", "module": "m14", "place": "learn", "title": "Read an income statement from top to bottom",
      "steps": ["Revenue", "Operating profit", "Profit before tax", "Net income"], "basis": "M14 subtopic ‘Financial statements in one hour’" },

    { "id": "m15-forward", "type": "explorer", "module": "m15", "example": "we-15.1", "exampleLabel": "Worked example 15.1", "title": "Fair forward price and arbitrage",
      "inputs": [{ "id": "s", "label": "Share price today", "min": 10, "max": 300, "step": 1, "value": 100 }, { "id": "r", "label": "One-year interest rate", "min": 0, "max": 15, "step": 0.25, "value": 6, "unit": "%" }, { "id": "q", "label": "Income yield on the share", "min": 0, "max": 10, "step": 0.25, "value": 0, "unit": "%" }, { "id": "fq", "label": "Forward quoted by a dealer", "min": 10, "max": 350, "step": 0.5, "value": 108 }],
      "outputs": [{ "label": "Fair forward price", "calc": "forwardArb", "args": ["s", "r%", "q%", "fq"], "pick": "fair", "dp": 2 }, { "label": "Riskless profit per share (+ cash-and-carry, − reverse)", "calc": "forwardArb", "args": ["s", "r%", "q%", "fq"], "pick": "profit", "dp": 2 }] },
    { "id": "m15-binomial", "type": "explorer", "module": "m15", "example": "we-15.2", "exampleLabel": "Worked example 15.2", "title": "One-step binomial option",
      "inputs": [{ "id": "u", "label": "Up-state price (from 100)", "min": 101, "max": 150, "step": 1, "value": 110 }, { "id": "d", "label": "Down-state price (from 100)", "min": 50, "max": 99, "step": 1, "value": 90 }, { "id": "R", "label": "Risk-free growth factor", "min": 1, "max": 1.15, "step": 0.005, "value": 1.05 }, { "id": "k", "label": "Strike", "min": 50, "max": 150, "step": 1, "value": 100 }],
      "outputs": [{ "label": "Call value", "calc": "binomialCall", "args": [100, "k", "u%", "d%", "R"], "dp": 2 }, { "label": "Risk-neutral probability of up", "calc": "riskNeutralP", "args": ["u%", "d%", "R"], "dp": 4 }],
      "note": "Keep the growth factor between the down and up moves (d < R < u), or riskless arbitrage would be possible." },
    { "id": "m15-bsm", "type": "explorer", "module": "m15", "example": "we-15.3", "exampleLabel": "Worked example 15.3", "title": "Black-Scholes-Merton: what moves the price?",
      "inputs": [{ "id": "s", "label": "Share price (S)", "min": 50, "max": 150, "step": 1, "value": 100 }, { "id": "k", "label": "Strike (K)", "min": 50, "max": 150, "step": 1, "value": 100 }, { "id": "t", "label": "Years to expiry (T)", "min": 0.1, "max": 5, "step": 0.1, "value": 1 }, { "id": "r", "label": "Risk-free rate (continuous)", "min": 0, "max": 15, "step": 0.25, "value": 5, "unit": "%" }, { "id": "v", "label": "Volatility (σ)", "min": 5, "max": 80, "step": 1, "value": 20, "unit": "%" }],
      "outputs": [{ "label": "European call", "calc": "bsCall", "args": ["s", "k", "t", "r%", "v%"], "dp": 2 }, { "label": "European put", "calc": "bsPut", "args": ["s", "k", "t", "r%", "v%"], "dp": 2 }],
      "chart": { "x": "v", "output": 0, "xLabel": "Volatility (%)", "yLabel": "Call value" },
      "note": "Try each input in turn and compare with the table in Worked example 15.4." },
    { "id": "m15-swap", "type": "explorer", "module": "m15", "example": "we-15.5", "exampleLabel": "Worked example 15.5", "title": "Par swap rate from spot rates",
      "inputs": [{ "id": "z1", "label": "1-year spot rate", "min": 0, "max": 15, "step": 0.25, "value": 6, "unit": "%" }, { "id": "z2", "label": "2-year spot rate", "min": 0, "max": 15, "step": 0.25, "value": 6.5, "unit": "%" }, { "id": "z3", "label": "3-year spot rate", "min": 0, "max": 15, "step": 0.25, "value": 7, "unit": "%" }],
      "outputs": [{ "label": "3-year par swap rate", "calc": "parSwap3", "args": ["z1%", "z2%", "z3%"], "scale": 100, "dp": 3, "unit": "%" }] },

    { "id": "m16-geo", "type": "explorer", "module": "m16", "example": "we-16.1", "exampleLabel": "Worked example 16.1", "title": "Arithmetic versus geometric average",
      "inputs": [{ "id": "a", "label": "Return in year 1", "min": -80, "max": 100, "step": 5, "value": 50, "unit": "%" }, { "id": "b", "label": "Return in year 2", "min": -80, "max": 100, "step": 5, "value": -50, "unit": "%" }],
      "outputs": [{ "label": "Arithmetic average", "calc": "arithmeticMean2", "args": ["a%", "b%"], "scale": 100, "dp": 2, "unit": "%" }, { "label": "Geometric average (what really happened)", "calc": "geometricMean2", "args": ["a%", "b%"], "scale": 100, "dp": 2, "unit": "%" }] },
    { "id": "m16-div", "type": "explorer", "module": "m16", "example": "we-16.2", "exampleLabel": "Worked example 16.2", "title": "Diversification in numbers",
      "inputs": [{ "id": "w", "label": "Weight in asset A", "min": 0, "max": 100, "step": 5, "value": 60, "unit": "%" }, { "id": "ra", "label": "Expected return A", "min": 0, "max": 20, "step": 0.5, "value": 10, "unit": "%" }, { "id": "sa", "label": "Standard deviation A", "min": 0, "max": 40, "step": 1, "value": 15, "unit": "%" }, { "id": "rb", "label": "Expected return B", "min": 0, "max": 20, "step": 0.5, "value": 6, "unit": "%" }, { "id": "sb", "label": "Standard deviation B", "min": 0, "max": 40, "step": 1, "value": 8, "unit": "%" }, { "id": "rho", "label": "Correlation", "min": -1, "max": 1, "step": 0.1, "value": 0.2 }],
      "outputs": [{ "label": "Portfolio expected return", "calc": "portfolioReturn", "args": ["w%", "ra%", "rb%"], "scale": 100, "dp": 2, "unit": "%" }, { "label": "Portfolio standard deviation", "calc": "portfolioSd", "args": ["w%", "sa%", "sb%", "rho"], "scale": 100, "dp": 2, "unit": "%" }],
      "chart": { "x": "rho", "output": 1, "xLabel": "Correlation", "yLabel": "Portfolio risk (%)" },
      "note": "Same expected return, less risk as correlation falls." },
    { "id": "m16-sml", "type": "explorer", "module": "m16", "example": "we-16.3", "exampleLabel": "Worked example 16.3", "title": "The security market line",
      "inputs": [{ "id": "rf", "label": "Risk-free rate", "min": 0, "max": 15, "step": 0.25, "value": 6, "unit": "%" }, { "id": "rm", "label": "Expected market return", "min": 0, "max": 25, "step": 0.25, "value": 12, "unit": "%" }, { "id": "b", "label": "Beta", "min": 0, "max": 2.5, "step": 0.05, "value": 1.55 }],
      "outputs": [{ "label": "Required return", "calc": "capmMarket", "args": ["rf%", "b", "rm%"], "scale": 100, "dp": 2, "unit": "%" }],
      "chart": { "x": "b", "output": 0, "xLabel": "Beta", "yLabel": "Required return (%)" } },

    { "id": "m17-var", "type": "explorer", "module": "m17", "example": "we-17.1", "exampleLabel": "Worked example 17.1", "title": "Parametric value at risk",
      "inputs": [{ "id": "v", "label": "Portfolio value", "min": 100000, "max": 100000000, "step": 100000, "value": 10000000 }, { "id": "sd", "label": "Daily standard deviation", "min": 0.1, "max": 5, "step": 0.1, "value": 1.2, "unit": "%" }, { "id": "days", "label": "Holding period (days)", "min": 1, "max": 30, "step": 1, "value": 1 }],
      "outputs": [{ "label": "95% VaR (z = 1.645)", "calc": "varDays", "args": ["v", "sd%", 1.645, "days"], "dp": 0 }, { "label": "99% VaR (z = 2.326)", "calc": "varDays", "args": ["v", "sd%", 2.326, "days"], "dp": 0 }],
      "chart": { "x": "days", "output": 0, "xLabel": "Holding period (days)", "yLabel": "95% VaR" },
      "note": "Scaling by √days assumes independent days — often untrue in a crisis." },
    { "id": "m17-el", "type": "explorer", "module": "m17", "example": "we-17.3", "exampleLabel": "Worked example 17.3", "title": "Expected credit loss",
      "inputs": [{ "id": "pd", "label": "Probability of default (1 year)", "min": 0, "max": 30, "step": 0.25, "value": 2, "unit": "%" }, { "id": "lgd", "label": "Loss given default", "min": 0, "max": 100, "step": 5, "value": 45, "unit": "%" }, { "id": "ead", "label": "Exposure at default", "min": 10000, "max": 10000000, "step": 10000, "value": 1000000 }],
      "outputs": [{ "label": "Expected loss", "calc": "expectedLoss", "args": ["pd%", "lgd%", "ead"], "dp": 0 }] },
