      "inputs": [{ "id": "i", "label": "Quoted annual rate", "min": 0, "max": 40, "step": 0.5, "value": 12, "unit": "%" }, { "id": "m", "label": "Compounding periods a year", "min": 1, "max": 365, "step": 1, "value": 12 }],
      "outputs": [{ "label": "Effective annual rate", "calc": "ear", "args": ["i%", "m"], "scale": 100, "dp": 2, "unit": "%" }],
