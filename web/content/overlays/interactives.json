      "outputs": [{ "label": "Real return (exact)", "calc": "realRate", "args": ["n%", "i%"], "scale": 100, "dp": 2, "unit": "%" }, { "label": "Shortcut: nominal − inflation", "calc": "realApprox", "args": ["n%", "i%"], "scale": 100, "dp": 2, "unit": "%" }],
      "chart": { "x": "i", "output": 0, "xLabel": "Inflation (%)", "yLabel": "Real return (%)", "yZero": true },
      "note": "Push both rates up: the shortcut drifts further from the exact answer when rates are high." },
    { "id": "m3-chain", "type": "sequencer", "module": "m3", "example": "we-3.2", "title": "From news to prices: order the reasoning chain",
